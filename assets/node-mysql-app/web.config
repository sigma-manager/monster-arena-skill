<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config dla MonsterASP.NET — Node.js przez IIS httpPlatformHandler
  (wg dokumentacji: https://help.monsterasp.net/books/nodejs/page/how-to-run-nodejs-application)

  Plik trafia do /wwwroot (root witryny).
  UWAGA: poniższe __DB_*__ to PLACEHOLDERY — skrypt scripts/deploy_ftp.py podmieni je
  wartościami z .deploy.env podczas deployu. Możesz też wpisać wartości ręcznie,
  ale wtedy nie commituj tego pliku do publicznego repo.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node" arguments=".\server.js" startupTimeLimit="20"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="DB_HOST" value="__DB_HOST__" />
        <environmentVariable name="DB_PORT" value="__DB_PORT__" />
        <environmentVariable name="DB_USER" value="__DB_USER__" />
        <environmentVariable name="DB_PASSWORD" value="__DB_PASSWORD__" />
        <environmentVariable name="DB_NAME" value="__DB_NAME__" />
        <environmentVariable name="DB_SSL" value="__DB_SSL__" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
